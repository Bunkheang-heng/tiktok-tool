# Ben10 FX Content Automation — Environment Configuration

# Application Mode: 'mock' (no API credits used) or 'production'
APP_MODE=mock

# Logging Level: 'trace', 'debug', 'info', 'warn', 'error'
LOG_LEVEL=info

# Telegram Delivery & Notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_NOTIFY_LEVEL=normal

# Gemini AI (Default LLM Provider)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Video Provider: 'mock', 'browser', 'api'
VIDEO_PROVIDER=mock

# Khmer TTS Provider: 'mock', 'edge', 'google'
TTS_PROVIDER=mock
TTS_VOICE=km-KH-SreymomNeural
TTS_RATE=1.0

# FFmpeg Executable (Leave empty to use system PATH ffmpeg)
FFMPEG_PATH=

# Local Storage Directory
STORAGE_DIR=./storage
