    "test:watch": "vitest --config vitest.config.ts",
    "package:win": "vite build && electron-builder --win"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "lucide-react": "^1.16.0",
    "pino": "^9.6.0",
    "react": "^18.3.1",
